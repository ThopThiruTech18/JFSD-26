package in.versionit;

public class No09EvenOddNumberCount {

	public static void main(String[] args) {

		int num = 12333;// 321
		int rem, sum = 0;
		int even = 0;
		int odd = 0;

		while (num > 0) {
			rem = num % 10;

			if (rem % 2 == 0) {
				even++;
			} else {
				odd++;
				num = num / 10;
			}

			System.out.println(even);
			System.out.println(odd);

		}
	}

}
