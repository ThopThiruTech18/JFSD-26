package in.thiruit;

public class Pattern5 {

	public static void main(String[] args) {
		
		
		
		
		for (int i = 0; i <= 5; i++) {
			
			for (int space = 1; space <= 5-i; space++) {
				
				System.out.print(" ");
				
			}
			
			for (int j = 1; j <=5; j++) {
				
				System.out.println("*");
				
			}
			
		}
		



	}

	

}
