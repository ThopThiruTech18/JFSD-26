package in.thiruit;

public class Example {
	
	public static void main(String[] args) {
		
		pattern1I();
	}

	private static void pattern1I() {
		System.out.println("for loop started");
		for (int i = 1; i <= 5; i++) {    //5*5
			
			for (int j = 1; j <= 5; j++) {   
				
				System.out.print(i);
				
			}
			System.out.println();
			
		}
	}
	
	
	private static void pattern1J() {
		System.out.println("for loop started");
		for (int i = 1; i <= 5; i++) {    //5*5
			
			for (int j = 1; j <= 5; j++) {   
				
				System.out.print(j);
				
			}
			System.out.println();
			
		}
	}

}
