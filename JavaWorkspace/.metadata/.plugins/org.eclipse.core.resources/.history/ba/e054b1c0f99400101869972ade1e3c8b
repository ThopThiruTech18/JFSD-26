package in.thiruit;

public class Example {
	
	public static void main(String[] args) {
		
		printNumbersVerticalOrder();
	}

	private static void printNumbersVerticalOrder() {
		System.out.println("for loop started");
		for (int i = 1; i <= 4; i++) {    //5*5
			
			for (int j = 1; j <= 5; j++) {   
				
				System.out.print(i);
				
			}
			System.out.println();
			
		}
	}

}
