package in.versionit;

public class No09EvenOddNumberCount {

	public static void main(String[] args) {

		int a=10;
		int b=10;
		int c=10;
		
		if((a>b) && (a>c))
		{
			System.out.println("A is a greatest number");
		}
		else if((b>a) && (b>c))
		{
			System.out.println("B is a greatest number");
		}
		else if((c>a) && (c>b))
		{
			System.out.println("C is a greatest number");
		}
		else
		{
			System.out.println("a,b,c are equal");
		}
	}

}
