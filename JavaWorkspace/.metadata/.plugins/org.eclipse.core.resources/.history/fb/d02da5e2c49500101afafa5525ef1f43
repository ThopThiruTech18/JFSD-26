package in.thiruit;

public class Pattern4 {

	public static void main(String[] args) {

		LeftBottomTriangle();

		for (int i = 1; i <= 5; i++) {

			for (int space = 1; space <= 5 - i; space++) {

				System.out.println(" ");

			}

			for (int j = 1; j <= i; j++) {

				System.out.print("*");

			}

			System.out.println();

		}

	}

	private static void LeftBottomTriangle() {
		for (int i = 1; i <= 5; i++) {

			for (int j = 1; j <= i; j++) {

				System.out.print("*");

			}

			System.out.println();

		}
	}

}
