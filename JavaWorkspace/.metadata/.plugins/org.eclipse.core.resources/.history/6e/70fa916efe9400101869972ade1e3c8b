package in.thiruit;

public class Pattern2 {

	public static void main(String[] args) {
		
		printTrianglePattern();
		printTrianglePatternJ();
		printTrianglePatternStar();
		printTrianglePatternNumbers()
		

	}
	
	
	public static void printTrianglePattern()
	{
		System.out.println("Loop is started");

		for (int i = 1; i <= 5; i++) {

			for (int j = 1; j <= i; j++) {
				
				System.out.print(i);

			}
			System.out.println();

		}
	}
	
	public static void printTrianglePatternJ()
	{
		System.out.println("Loop is started");

		for (int i = 1; i <= 5; i++) {

			for (int j = 1; j <= i; j++) {
				
				System.out.print(j);

			}
			System.out.println();

		}
	}
	
	public static void printTrianglePatternStar()
	{
		System.out.println("Loop is started");

		for (int i = 1; i <= 5; i++) {

			for (int j = 1; j <= i; j++) {
				
				System.out.print("*");

			}
			System.out.println();

		}
	}
	
	
	public static void printTrianglePatternNumbers()
	{
		
		int k=1;
		System.out.println("Loop is started");

		for (int i = 1; i <= 5; i++) {

			for (int j = 1; j <= i; j++) {
				
				System.out.print((k++)+"  ");

			}
			System.out.println();

		}
	}

}
