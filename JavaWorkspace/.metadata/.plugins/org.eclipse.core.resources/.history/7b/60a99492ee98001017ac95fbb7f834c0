package in.versionit;

public class No09EvenOddNumberCount {

	public static void main(String[] args) {

		int num = 123;//321
		int rem, sum = 0;
		int even=0;
		int odd=0;

		while (num > 0) {
			rem = num % 10;
			
			if(rem%2==0)
			{
				even++;
			}
			else
			{
				odd++;
			
			sum = sum*10 + rem;  //0*10+3==>3,3*10+2==>32,32*10+1=321
			num = num / 10;
		}
		
		System.out.println(sum);

	}
	}

}
