	private static void LeftBottomTriangle() {
		for (int i = 1; i <= 5; i++) {

			for (int j = 1; j <= i; j++) {

				System.out.print("*");

			}

			System.out.println();

		}
	}
	
	private static void RightBottomTriangle() {
		System.out.println("Loop started");
		for (int i = 1; i <= 5; i++) {

		for (int space = 1; space <= 5 - i; space++) {

			System.out.print("  ");

		}

		for (int j = 1; j <= i; j++) {

			System.out.print("* ");

		}

		System.out.println();

	}}
	
	
	private static void LeftTopTriangle() {
		for (int i = 5; i >= 1 ; i--) {

			for (int j = 1; j <= i; j++) {

				System.out.print("*");

			}

			System.out.println();

		}
	}
	
	
	private static void RightTopTriangle() {
		for (int i = 5; i >= 1 ; i--) {
			
			
			
			
			
			

			for (int j = 1; j <= i; j++) {

				System.out.print("*");

			}

			System.out.println();

		}
	}

}
